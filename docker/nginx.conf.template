# SPA do Trophy Hunter. Gerado de /etc/nginx/templates no start (envsubst só de ${CSP_*};
# $uri etc. ficam para o nginx). A API NÃO passa por aqui: vive em api.<app>.<domínio> (CORS).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;
    gzip_min_length 1024;

    # CSP: self + API + a origem do Keycloak (connect-src/frame-src p/ login e silent renew); imagens dos
    # CDNs de Steam/PSN em img-src E connect-src (o service worker busca as imagens com fetch(), que obedece
    # ao connect-src — sem isso o cache de capas bloqueia todas as imagens). Lista em CSP_IMAGE_HOSTS.
    # CDNs de Steam/PSN; data:/blob: p/ capas em cache do SW. frame-ancestors none (não embutível).
    set $csp "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ${CSP_IMAGE_HOSTS}; font-src 'self' data:; connect-src ${CSP_CONNECT_SRC}; frame-src ${CSP_FRAME_SRC}; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' ${CSP_FRAME_SRC}; object-src 'none'";

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Configuração de runtime (gerada pelo 05-app-config.envsh) — nunca cachear.
    location = /config.js {
        alias /tmp/app-config/config.js;
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy $csp always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Manifest: sem cache (o service worker, servido pelo bloco `/`, já cai em no-cache).
    location = /manifest.webmanifest {
        try_files $uri =404;
        default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
    }

    # Assets com hash no nome: cache longo e imutável.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # SPA: qualquer rota cai no index.html (sem cache, para pegar o deploy novo na hora).
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        add_header Content-Security-Policy $csp always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
    }
}
