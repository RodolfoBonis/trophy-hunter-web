# Copie para .env.local (dev contra a API real). Em produção estes valores vêm do /config.js
# gerado no start do container a partir das envs OIDC_AUTHORITY/OIDC_CLIENT_ID/OIDC_SCOPE/API_BASE_URL.
VITE_OIDC_AUTHORITY=https://auth.rb.lab/realms/platform
VITE_OIDC_CLIENT_ID=trophy-hunter-web
# O aud=trophy-hunter-api vem do client scope default aud-trophy-hunter-api (não se pede).
VITE_OIDC_SCOPE=openid profile email
# A API vive no próprio subdomínio (api.<app>.<domínio>) e é chamada direto (CORS). Em dev, a API Go
# local libera http://localhost:5173 via CORS_ALLOWED_ORIGINS.
VITE_API_BASE=http://localhost:8080/api

# --- Runtime do container (não usado em dev; referência) ---------------------------------------
# Origem da API (sem caminho). Em prod:
#   API_BASE_URL=https://api.trophy.rb.lab
