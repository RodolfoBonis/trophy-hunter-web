# Copie para .env.local (dev contra a API real). Em produção estes valores vêm do /config.js
# gerado no start do container a partir das envs OIDC_AUTHORITY/OIDC_CLIENT_ID/OIDC_SCOPE/API_UPSTREAM.
VITE_OIDC_AUTHORITY=https://auth.rb.lab/realms/platform
VITE_OIDC_CLIENT_ID=trophy-hunter-web
# openid profile email + o audience scope `trophy-hunter-api` (injeta aud=trophy-hunter-api no token).
VITE_OIDC_SCOPE=openid profile email trophy-hunter-api
# Mesma origem do app; o nginx/dev-proxy encaminha /api → API Go (que serve /api/v1).
VITE_API_BASE=/api
# Dev sem Docker: alvo do proxy do Vite para /api (a API Go local).
VITE_API_PROXY=http://localhost:8080

# --- Runtime do container (não usado em dev; referência) ---------------------------------------
# O nginx do container encaminha /api → API_UPSTREAM (sem reescrever o path). Em prod:
#   API_UPSTREAM=http://trophy-hunter-api-svc:8080
